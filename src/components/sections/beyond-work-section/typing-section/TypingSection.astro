---
import KeyboardIcon from '@tabler/icons/outline/keyboard.svg';

import MonkeytypeAtHome from '@/components/react/MonkeytypeAtHome';
import InlineLink from '@/components/ui/InlineLink.astro';
import { BeyondWorkLink } from '@/components/ui/repo-summary/data';
import SubSection from '@/components/ui/sub-section';
import SubSectionDescription from '@/components/ui/sub-section/SubSectionDescription.astro';
import SubSectionTitle from '@/components/ui/sub-section/SubSectionTitle.astro';
---

<SubSection id='beyond-work-typing' class='revealing revealing-3'>
  <SubSectionTitle icon={KeyboardIcon}>Typing</SubSectionTitle>
  <SubSectionDescription>
    I find comfort in typing tests with a <InlineLink
      href={BeyondWorkLink.GLOVE80}>Glove80</InlineLink
    > keyboard and liked the <InlineLink
      href={BeyondWorkLink.MONKEYTYPE_PROFILE}
    >
      Monkeytype
    </InlineLink> app enough to build a mini version below.
  </SubSectionDescription>

  <MonkeytypeAtHome client:idle />
</SubSection>
