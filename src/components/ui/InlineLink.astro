---
import { cn } from 'tailwind-variants';

import NewTabSrIndicator from './NewTabSrIndicator.astro';

type Props = astroHTML.JSX.AnchorHTMLAttributes;
const { class: className, ...rest } = Astro.props;
---

<a
  target='_blank'
  rel='noopener noreferrer'
  class={cn(
    `
      group relative inline-flex bouncy-click rounded-2xs text-primary underline
      underline-offset-3 outline-none
      hover:bg-primary/20 hover:text-primary
      focus-visible:no-underline focus-visible:ring-2
      focus-visible:ring-primary/80
    `,
    className,
  )}
  {...rest}
  ><slot /><NewTabSrIndicator />
</a>
