---
import '@/styles/index.css';
import SvgSprite from '@/components/ui/SvgSprite.astro';

import Footer from './Footer.astro';
import Header from './header';
import BaseLayout, { type BaseLayoutProps } from '../BaseLayout.astro';

interface Props {
  title?: BaseLayoutProps['title'];
}
const { title } = Astro.props;
---

<BaseLayout {title}>
  <SvgSprite />
  <button
    class='
      sr-only rounded-sm bg-primary/10 px-3! py-1.5! font-bold text-primary
      focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50
    '
    onclick="document.getElementById('hero-name')?.focus()"
  >
    Skip navigation
  </button>
  <Header />
  <main
    id='main-content'
    class='
      grow px-2.5 py-10
      xs:px-3
      md:px-6
    '
  >
    <slot />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { easterEggLog } from './utils';
  easterEggLog();
</script>
