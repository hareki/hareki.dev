---
import BrowserIcon from '@tabler/icons/outline/browser.svg';

import Badge from '@/components/ui/Badge.astro';
import BoxSection from '@/components/ui/box-section';
import BoxSectionDescription from '@/components/ui/box-section/BoxSectionDescription.astro';
import BoxSectionTitle from '@/components/ui/box-section/BoxSectionTitle.astro';
import InlineLink from '@/components/ui/InlineLink.astro';
import SubsectionTitle from '@/components/ui/SubsectionTitle.astro';
import { PROJECT_REPO_FULL_NAME } from '@/data/git';
import { ThisWebSiteData } from '@/data/this-website';
---

<BoxSection id='beyond-work-this-website' class='revealing revealing-5'>
  <BoxSectionTitle icon={BrowserIcon}>This Website</BoxSectionTitle>
  <BoxSectionDescription>
    First time work with, <InlineLink href='https://astro.build/'
      >Astro</InlineLink
    > also my first website outside of work. Built from scratch with clear goals in
    mind. Source on <InlineLink
      href={`https://github.com/${PROJECT_REPO_FULL_NAME}`}>GitHub</InlineLink
    >.
  </BoxSectionDescription>

  <div class='rounded-md bg-inner-box px-1 py-2 text-sm'>
    <SubsectionTitle class='px-2'>Core Principles</SubsectionTitle>
    <div class='mb-6 flex flex-col'>
      {
        ThisWebSiteData.CORE_PRINCIPLES.map(({ name, description }) => {
          return (
            <span
              class='
                group inline-flex max-w-full rounded-xs p-1.5
                text-subtext0-foreground
              '
            >
              <div class='flex min-w-0 items-center gap-1'>
                <div>
                  <span class='font-medium whitespace-nowrap text-foreground'>
                    {name}
                  </span>
                  <span>{description}</span>
                </div>
              </div>
            </span>
          );
        })
      }
    </div>

    <div class='flex flex-wrap justify-between gap-x-5 gap-y-4.5 px-2'>
      <div>
        <SubsectionTitle>Technologies</SubsectionTitle>
        <div class='flex flex-wrap gap-2'>
          {
            ThisWebSiteData.TECHNOLOGIES.map(({ name, color }) => (
              <Badge color={color}>{name}</Badge>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</BoxSection>
