---
import {
  Tooltip,
  TooltipContent,
  TooltipTrigger,
} from '@/components/starwind/tooltip';
import { MAIN_MODULES } from '@/data/beyond-work';
import { getLanguageStats, getRecentCommitDetails } from '@/lib/github';
import { parseConventionalCommit } from '@/lib/github/utils';
import { getDateDistance, getFormattedDateTime } from '@/utils/date';

import Badge from '../Badge.astro';
import StandaloneLink from '../StandaloneLink.astro';
import SubsectionTitle from '../SubsectionTitle.astro';

interface Props {
  repoFullName: string;
  commitLimit: number;
}

Astro.cache.set({
  maxAge: 900,
  swr: 60,
});

const { repoFullName, commitLimit } = Astro.props;
const [commits, languages] = await Promise.all([
  getRecentCommitDetails(repoFullName, commitLimit),
  getLanguageStats(repoFullName),
]);
---

<div class='@container rounded-md bg-inner-box px-1 py-2 text-sm'>
  <SubsectionTitle class='px-2'> Recent Commits </SubsectionTitle>
  <div class='
    mb-6 flex flex-col gap-1
    @md:gap-0
  '>
    {
      commits.map((commit) => {
        const parsed = parseConventionalCommit(commit.commitMessage);

        return (
          <a
            href={commit.commitUrl}
            target='_blank'
            rel='noopener noreferrer'
            class='
              group flex w-full bouncy-click flex-col items-start gap-x-3
              gap-y-1 rounded-xs p-1.5 text-subtext0-foreground
              hover:bg-primary/10 hover:text-primary/70
              @md:flex-row @md:items-center @md:gap-5
              motion-safe:not-disabled:hocus:scale-[100.5%]
            '
          >
            <div
              class='
                min-w-0
                @md:flex-1
              '
            >
              {parsed.prefix ? (
                <>
                  <span
                    class='
                      font-medium whitespace-nowrap text-foreground
                      group-hover:text-primary
                    '
                  >
                    {parsed.prefix}
                  </span>{' '}
                  <span>{parsed.message}</span>
                </>
              ) : (
                <span>{commit.commitMessage}</span>
              )}
              <span
                class='
                  ml-1 hidden whitespace-nowrap
                  @md:inline
                '
              >
                <span class='text-success'>+{commit.linesAdded}</span>
                <span class='text-error'>-{commit.linesDeleted}</span>
              </span>
            </div>

            <div
              class='
                flex w-full items-center
                @md:w-auto @md:shrink-0 @md:justify-end
              '
            >
              <span
                class='
                  whitespace-nowrap
                  @md:hidden
                '
              >
                <span class='text-success'>+{commit.linesAdded}</span>
                <span class='text-error'>-{commit.linesDeleted}</span>
              </span>

              <span
                class='
                  mx-1.5 text-muted-foreground
                  @md:hidden
                '
              >
                &#8226;
              </span>
              <Tooltip>
                <TooltipTrigger>
                  <span
                    class='
                      whitespace-nowrap
                      group-hover:text-primary/70
                    '
                  >
                    {getDateDistance(commit.createdAt)}
                  </span>
                </TooltipTrigger>

                <TooltipContent class='text-sm font-medium'>
                  <span data-utc={commit.createdAt.toISOString()}>
                    {getFormattedDateTime(commit.createdAt)}
                  </span>
                </TooltipContent>
              </Tooltip>
            </div>
          </a>
        );
      })
    }
  </div>

  <div class='flex flex-wrap justify-between gap-x-5 gap-y-4.5 px-2'>
    <div>
      <SubsectionTitle> Languages </SubsectionTitle>
      <div class='flex flex-wrap gap-2'>
        {
          languages.map(({ name, percent, color }) => (
            <Badge color={color} extraInfo={`${percent}%`}>
              {name}
            </Badge>
          ))
        }
      </div>
    </div>

    <div>
      <SubsectionTitle> Main Modules </SubsectionTitle>
      <div class='flex gap-3'>
        {
          MAIN_MODULES.map(({ name, url, ariaLabel }) => (
            <StandaloneLink href={url} aria-label={ariaLabel}>
              {name}
            </StandaloneLink>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import { initStarwind } from '@/lib/starwind/event';
  import { getFormattedDateTime } from '@/utils/date';

  initStarwind();
  document.querySelectorAll<HTMLSpanElement>('[data-utc]').forEach((el) => {
    if (!el.dataset.utc) {
      throw new Error('UTC data attribute is missing');
    }

    el.textContent = getFormattedDateTime(new Date(el.dataset.utc));
  });
</script>
