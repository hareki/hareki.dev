---
import HeartIcon from '@tabler/icons/outline/heart.svg';

import Button from '@/components/starwind/button';
import { PopoverTrigger } from '@/components/starwind/popover';

import PopoverIndicator from '../PopoverIndicator.astro';
---

<PopoverTrigger asChild>
  <Button variant='ghost' class='w-fit'>
    <HeartIcon />
    <span>Credits</span>
    <PopoverIndicator size='md' orientation='up' />
  </Button>
</PopoverTrigger>
