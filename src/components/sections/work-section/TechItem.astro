---
import { cn } from 'tailwind-variants';

import LinkItem from '@/components/ui/LinkItem.astro';

interface Props {
  name: string;
  description: string;
  href: string;
  icon: ImageMetadata;
  iconClass?: string;
  iconSize?: number;
  darkIcon?: ImageMetadata;
}

export type TechItemProps = Props;

const { name, description, href, icon, darkIcon, iconClass } = Astro.props;

const computedIconClass = cn(
  `
    absolute top-[50%] left-[50%] size-10 translate-[-50%] transition-all
    duration-350
  `,
  iconClass,
);
const baseProps = {
  width: 40,
  height: 40,
} as const;

const alt = `${name} logo`;

const lightIconProps = {
  ...baseProps,
  class: cn(
    computedIconClass,
    darkIcon &&
      `
        opacity-100
        dark:opacity-0
      `,
  ),
};

const darkIconProps = darkIcon && {
  ...baseProps,
  class: cn(
    computedIconClass,
    `
      opacity-0
      dark:opacity-100
    `,
  ),
};
---

<LinkItem name={name} description={description} href={href}>
  <div
    slot='icon'
    class={cn('relative size-10 shrink-0 overflow-visible muted-icon')}
  >
    <img src={icon.src} {...lightIconProps} {alt} />
    {darkIcon && <img src={darkIcon.src} {...darkIconProps} {alt} />}
  </div>
</LinkItem>
