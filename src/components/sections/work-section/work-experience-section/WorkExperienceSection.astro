---
import { Popover } from '@/components/starwind/popover';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import StandaloneLink from '@/components/ui/StandaloneLink.astro';
import ContactInformation from '@/data/contact-information';
import { EXPERIENCE } from '@/data/experience';

import WorkExperiencePopoverContent from './WorkExperiencePopoverContent.astro';
import WorkExperiencePopoverTrigger from './WorkExperiencePopoverTrigger.astro';
---

<section id='work-experience' class='revealing revealing-2'>
  <SectionTitle>Work Experience</SectionTitle>

  <div class='mb-2 flex gap-3'>
    {
      EXPERIENCE.map((record) => (
        <div>
          <Popover class='group'>
            <WorkExperiencePopoverTrigger record={record} />
            <WorkExperiencePopoverContent record={record} />
          </Popover>
        </div>
      ))
    }
  </div>
  <StandaloneLink class='ml-3' href={ContactInformation.RESUME_URL}>
    View Full Résumé
  </StandaloneLink>
</section>
