---
import { PopoverTitle } from '@/components/starwind/popover';
import LinkItem from '@/components/ui/LinkItem.astro';

import { type SiteEntry } from './data';

interface Props {
  title: string;
  items: SiteEntry[];
  class?: string;
}

const getFaviconSrc = (favicon: ImageMetadata | string): string => {
  return typeof favicon === 'string' ? favicon : favicon.src;
};

const { title, items } = Astro.props;
---

<div>
  <PopoverTitle>{title}</PopoverTitle>
  <div class='grid gap-1'>
    {
      items.map(({ name, description, url, favicon }) => (
        <LinkItem name={name} description={description} href={url} size='sm'>
          <img
            slot='icon'
            src={getFaviconSrc(favicon)}
            alt={`${name} favicon`}
            class='dot-9 muted-icon'
            decoding='async'
          />
        </LinkItem>
      ))
    }
  </div>
</div>
