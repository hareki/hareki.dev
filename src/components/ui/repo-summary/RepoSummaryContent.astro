---
import {
  Tooltip,
  TooltipContent,
  TooltipTrigger,
} from '@/components/starwind/tooltip';
import { getLanguageStats, getRecentCommitDetails } from '@/lib/github';
import { CachingPolicy } from '@/lib/github/constants';
import { parseConventionalCommit } from '@/lib/github/utils';

import Badge from '../Badge.astro';
import StandaloneLink from '../StandaloneLink.astro';
import SubsectionTitle from '../SubsectionTitle.astro';
import { MAIN_MODULES } from './data';

interface Props {
  repoFullName: string;
  commitLimit: number;
}

Astro.cache.set({
  maxAge: CachingPolicy.MAX_AGE,
  swr: CachingPolicy.SWR,
});

const { repoFullName, commitLimit } = Astro.props;
const [commits, languages] = await Promise.all([
  getRecentCommitDetails(repoFullName, commitLimit),
  getLanguageStats(repoFullName),
]);
---

<div class='@container rounded-lg bg-sub-section px-3 py-4 text-sm'>
  <SubsectionTitle class='px-1.5'> Recent Commits </SubsectionTitle>
  <div class='
    mb-4 flex flex-col gap-1
    @md:gap-0
  '>
    {
      commits.length > 0 ? (
        commits.map((commit) => {
          const parsed = parseConventionalCommit(commit.commitMessage);

          return (
            <a
              href={commit.commitUrl}
              target='_blank'
              rel='noopener noreferrer'
              class='
                group flex w-full bouncy-click flex-col items-start gap-x-3
                gap-y-1 rounded-xs p-1.5 text-subtext0-foreground
                hover:bg-primary/10 hover:text-primary/75
                @md:flex-row @md:items-center @md:gap-5
                motion-safe:not-disabled:hocus:scale-[100.5%]
              '
            >
              <div
                class='
                  min-w-0
                  @md:flex-1
                '
              >
                {parsed.prefix ? (
                  <>
                    <span
                      class='
                        whitespace-nowrap text-foreground
                        group-hover:text-primary
                      '
                    >
                      {parsed.prefix}
                    </span>{' '}
                    <span>{parsed.message}</span>
                  </>
                ) : (
                  <span>{commit.commitMessage}</span>
                )}
                <span
                  class='
                    ml-1 hidden whitespace-nowrap
                    @md:inline
                  '
                >
                  <span
                    class='text-success'
                    aria-label={`${commit.linesAdded} lines added`}
                  >
                    +{commit.linesAdded}
                  </span>
                  <span
                    class='text-error'
                    aria-label={`${commit.linesDeleted} lines deleted`}
                  >
                    -{commit.linesDeleted}
                  </span>
                </span>
              </div>

              <div
                class='
                  flex w-full items-center
                  @md:w-auto @md:shrink-0 @md:justify-end
                '
              >
                <span
                  class='
                    whitespace-nowrap
                    @md:hidden
                  '
                >
                  <span
                    class='text-success'
                    aria-label={`${commit.linesAdded} lines added`}
                  >
                    +{commit.linesAdded}
                  </span>
                  <span
                    class='text-error'
                    aria-label={`${commit.linesDeleted} lines deleted`}
                  >
                    -{commit.linesDeleted}
                  </span>
                </span>

                <span
                  class='
                    mx-1.5 hidden text-subtext0-foreground
                    @md:hidden
                  '
                  data-commit-dot
                >
                  &#8226;
                </span>
                <Tooltip>
                  <TooltipTrigger>
                    <span
                      class='
                        whitespace-nowrap
                        group-hover:text-primary/75
                      '
                      data-commit-date={commit.createdAt.toISOString()}
                    />
                  </TooltipTrigger>

                  <TooltipContent class='text-sm'>
                    <span />
                  </TooltipContent>
                </Tooltip>
              </div>
            </a>
          );
        })
      ) : (
        <p class='px-1.5 text-error'>Unable to fetch recent commits</p>
      )
    }
  </div>

  <div class='flex flex-wrap justify-between gap-x-5 gap-y-4 px-1.5'>
    <div>
      <SubsectionTitle> Languages </SubsectionTitle>
      <div class='flex flex-wrap gap-2'>
        {
          languages.length > 0 ? (
            languages.map(({ name, percent, color }) => (
              <Badge color={color} extraInfo={`${percent}%`}>
                {name}
              </Badge>
            ))
          ) : (
            <p class='text-error'>Unable to fetch languages</p>
          )
        }
      </div>
    </div>

    <div>
      <SubsectionTitle> Main Modules </SubsectionTitle>
      <div class='flex gap-3'>
        {
          MAIN_MODULES.map(({ name, url, ariaLabel }) => (
            <StandaloneLink href={url} aria-label={ariaLabel}>
              {name}
            </StandaloneLink>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import { initStarwind } from '@/lib/starwind/event';
  import { getDateDistance, getFormattedDateTime } from '@/utils/date';

  const SECOND = 1000; // ms
  const MINUTE = 60 * SECOND;
  const HOUR = 60 * MINUTE;
  const DAY = 24 * HOUR;
  const WEEK = 7 * DAY;

  const getNextUpdateDelay = (date: Date): number | null => {
    const diff = Date.now() - date.getTime();
    if (diff < MINUTE) {
      return MINUTE - diff;
    }
    if (diff < HOUR) {
      return MINUTE - (diff % MINUTE);
    }
    if (diff < DAY) {
      return HOUR - (diff % HOUR);
    }
    if (diff < WEEK) {
      return DAY - (diff % DAY);
    }
    return null;
  };

  let timeoutIds: ReturnType<typeof setTimeout>[] = [];

  const destroyLiveCommitDates = () => {
    timeoutIds.forEach(clearTimeout);
    timeoutIds = [];
  };

  const initLiveCommitDates = () => {
    destroyLiveCommitDates();

    document
      .querySelectorAll<HTMLSpanElement>('[data-commit-date]')
      .forEach((el) => {
        const utc = el.dataset.commitDate;
        if (!utc) {
          throw new Error('commit-date data attribute is missing');
        }

        const date = new Date(utc);

        // Set tooltip content (sibling TooltipContent's inner span)
        const tooltipContent = el
          .closest('[data-slot="tooltip"]')
          ?.querySelector<HTMLSpanElement>(
            '[data-slot="tooltip-content"] > span',
          );
        if (tooltipContent) {
          tooltipContent.textContent = getFormattedDateTime(date);
        }

        // Only reveal the middle dot when we're 100% sure that date distance is there
        const dot = el.closest('[data-slot="tooltip"]')?.previousElementSibling;
        if (dot instanceof HTMLElement && 'commitDot' in dot.dataset) {
          dot.classList.remove('hidden');
        }

        // Live-update date distance
        const update = () => {
          const diff = Date.now() - date.getTime();
          // PERF: Actual seconds get stale every second, updating all of them might be a bottleneck
          el.textContent = diff < MINUTE ? 'now' : getDateDistance(date);
          const interval = getNextUpdateDelay(date);
          if (interval !== null) {
            timeoutIds.push(setTimeout(update, interval));
          }
        };

        update();
      });
  };

  initStarwind();
  initLiveCommitDates();
  document.addEventListener('astro:before-swap', destroyLiveCommitDates);
  document.addEventListener('astro:after-swap', initLiveCommitDates);
</script>
