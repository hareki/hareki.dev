<span class='group relative inline-flex' data-text-transformer>
  <span class='
    inline-grid overflow-hidden
    *:[grid-area:1/1]
  '>
    <span
      data-text-original
      class='
        group-data-[transformed="true"]:opacity-0
        motion-safe:transition-[opacity,translate]
        motion-safe:duration-[150ms,350ms]
        motion-safe:group-data-[transformed="true"]:-translate-y-full
        motion-reduce:transition-opacity motion-reduce:duration-350
      '
    >
      <slot name='original' />
    </span>

    <span
      data-text-transformed
      class='
        opacity-0 duration-5000
        group-data-[transformed="true"]:opacity-100
        motion-safe:translate-y-full motion-safe:transition-[opacity,translate]
        motion-safe:duration-[150ms,350ms]
        motion-safe:group-data-[transformed="true"]:translate-y-0
        motion-reduce:transition-opacity motion-reduce:duration-350
      '
    >
      <slot name='transformed' />
    </span>
  </span>
</span>
