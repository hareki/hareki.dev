---
import '@/styles/index.css';
import favicon from '@/assets/favicon.svg';
import boldFont from '@/assets/fonts/MapleMono-bold.woff2';
import regularFont from '@/assets/fonts/MapleMono-Regular.woff2';
import SvgSprite from '@/components/ui/SvgSprite.astro';

import Footer from './Footer.astro';
import Header from './header';

interface Props {
  title?: string;
}
const { title } = Astro.props;
const baseTitle = 'Hareki';
---

<!doctype html>
<html lang='en' class='h-screen w-full font-display scrollbar-primary'>
  <head>
    <!-- Quick way to check mobile logs -->
    <!-- <script src='https://cdn.jsdelivr.net/npm/eruda'></script> -->
    <!-- <script> -->
    <!--   eruda.init(); -->
    <!-- </script> -->

    <script is:inline>
      (function () {
        const html = document.documentElement;
        const mq = matchMedia('(prefers-color-scheme:dark)');
        const ms = localStorage.getItem('THEME_match-system');
        const flavor = localStorage.getItem('THEME_ctp-flavor');
        const darkFlavor = localStorage.getItem('THEME_dark-flavor') || 'mocha';
        const accent = localStorage.getItem('THEME_ctp-accent') || 'blue';

        const setFlavor = (f) => {
          html.className = html.className.replace(/\bctp-flavor-\S+/g, '');
          html.classList.add('theme-switching', 'ctp-flavor-' + f);
          void html.offsetHeight;
          html.classList.remove('theme-switching');
        };

        // New user (no keys) => match-system ON
        // Existing user (has flavor but no ms key) => match-system OFF
        const isMatchSystem = ms === 'true' || (ms === null && flavor === null);

        if (isMatchSystem) {
          setFlavor(mq.matches ? darkFlavor : 'latte');
        } else {
          setFlavor(flavor || (mq.matches ? 'mocha' : 'latte'));
        }

        html.classList.add('ctp-accent-' + accent);

        mq.addEventListener('change', function (e) {
          const m = localStorage.getItem('THEME_match-system');
          const f = localStorage.getItem('THEME_ctp-flavor');
          if (m === 'true' || (m === null && f === null)) {
            const df = localStorage.getItem('THEME_dark-flavor') || 'mocha';
            setFlavor(e.matches ? df : 'latte');
          }
        });
      })();
    </script>
    <link
      href={regularFont}
      rel='preload'
      type='font/woff2'
      as='font'
      crossorigin
    />

    <link
      href={boldFont}
      rel='preload'
      type='font/woff2'
      as='font'
      crossorigin
    />
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href={favicon.src} />
    <meta name='generator' content={Astro.generator} />
    <meta
      name='description'
      content='Hareki — software engineer portfolio featuring work experience, projects, and an interactive typing test built with Astro and React.'
    />
    <title>{title ? `${title} | ${baseTitle}` : baseTitle}</title>
  </head>
  <body>
    <SvgSprite />
    <div
      class='
        mx-auto flex min-h-screen max-w-5xl flex-col px-2 pb-4 text-foreground
        xs:px-3
      '
    >
      <Header />
      <main
        class='
          grow px-2.5 py-10
          xs:px-3
          md:px-6
        '
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
