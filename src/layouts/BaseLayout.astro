---
import '@/styles/index.css';
import favicon from '@/assets/favicon.svg';
import boldFont from '@/assets/fonts/MapleMono-Bold.woff2';
import mediumFont from '@/assets/fonts/MapleMono-Medium.woff2';

interface Props {
  title?: string;
}
const { title } = Astro.props;
const baseTitle = 'Hareki';
const description =
  'Tu "Hareki" Nguyen - Software engineer who builds scalable applications and loves optimizing workflow.';
const fullTitle = title ? `${title} | ${baseTitle}` : baseTitle;
---

<!doctype html>
<html lang='en' class='h-screen w-full font-display scrollbar-primary'>
  <head>
    <meta charset='UTF-8' />

    <!--
      Theme Switching Handler
      `is:inline` can't use imports, so the logic duplicates AppearanceSettingsController a bit.
      It's worth the trade off to prevent a flash of wrong-theme content on first paint
    -->
    <script is:inline>
      (function () {
        const html = document.documentElement;
        const preferDarkMode = matchMedia('(prefers-color-scheme:dark)');
        const matchSystemKey = localStorage.getItem('THEME_match-system');
        const flavor = localStorage.getItem('THEME_ctp-flavor');
        const darkFlavor = localStorage.getItem('THEME_dark-flavor') || 'mocha';
        const accent = localStorage.getItem('THEME_ctp-accent') || 'blue';

        const setFlavor = (f) => {
          html.className = html.className.replace(/\bctp-flavor-\S+/g, '');
          html.classList.add('theme-switching', 'ctp-flavor-' + f);
          void html.offsetHeight;
          html.classList.remove('theme-switching');
        };

        // New user (no keys) => match-system ON
        // Existing user (has flavor but no ms key) => match-system OFF
        const isMatchSystem =
          matchSystemKey === 'true' ||
          (matchSystemKey === null && flavor === null);

        if (isMatchSystem) {
          setFlavor(preferDarkMode.matches ? darkFlavor : 'latte');
        } else {
          setFlavor(flavor || (preferDarkMode.matches ? 'mocha' : 'latte'));
        }

        html.classList.add('ctp-accent-' + accent);

        preferDarkMode.addEventListener('change', function (e) {
          const m = localStorage.getItem('THEME_match-system');
          const f = localStorage.getItem('THEME_ctp-flavor');
          if (m === 'true' || (m === null && f === null)) {
            const df = localStorage.getItem('THEME_dark-flavor') || 'mocha';
            setFlavor(e.matches ? df : 'latte');
          }
        });
      })();
    </script>

    <link
      href={mediumFont}
      rel='preload'
      type='font/woff2'
      as='font'
      crossorigin
    />

    <link
      href={boldFont}
      rel='preload'
      type='font/woff2'
      as='font'
      crossorigin
    />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href={favicon.src} />
    <meta name='generator' content={Astro.generator} />
    <meta name='description' content={description} />
    <title>{fullTitle}</title>

    <!-- For link preview rendering -->
    <meta property='og:title' content={fullTitle} />
    <meta property='og:type' content='website' />
    <meta property='og:locale' content='en_US' />
    <meta property='og:description' content={description} />
    <meta property='og:url' content={Astro.url} />
    <meta property='og:site_name' content={baseTitle} />
    <meta
      property='og:image'
      content={Astro.url + 'open-graph/standard-1774795244746.jpg'}
    />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:site_name' content={baseTitle} />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:site' content='@Hareki139' />
    <meta name='twitter:title' content={fullTitle} />
    <meta name='twitter:description' content={description} />
    <meta
      property='twitter:image'
      content={Astro.url + 'open-graph/twitter-1774795244746.jpg'}
    />

    <meta name='author' content={baseTitle} />
    <meta name='robots' content='index, follow' />
    <link rel='canonical' href={Astro.url} />
  </head>
  <body>
    <slot />
  </body>
</html>
