---
import { PopoverContent } from '@/components/starwind/popover';
import { INSPIRATIONAL_SITES, COLOPHON } from '@/data/tools-and-inspirations';

import CreditsPopoverContentSection from './CreditsPopoverContentSection.astro';
---

<PopoverContent side='top' aria-label='Tools & Inspirations' class='p-4'>
  <div class='space-y-4'>
    <CreditsPopoverContentSection title='Colophon' items={COLOPHON} />
    <CreditsPopoverContentSection
      title='Inspirations'
      items={INSPIRATIONAL_SITES}
    />
  </div>
</PopoverContent>
