---
import MoonIconFilled from '@tabler/icons/filled/moon.svg';
import SunIconFilled from '@tabler/icons/filled/sun.svg';
import MoonIcon from '@tabler/icons/outline/moon.svg';
import SunIcon from '@tabler/icons/outline/sun.svg';

import Button from '@/components/starwind/button';
import { PopoverContent, PopoverTitle } from '@/components/starwind/popover';
import { Switch } from '@/components/starwind/switch';
import {
  Tooltip,
  TooltipContent,
  TooltipTrigger,
} from '@/components/starwind/tooltip';
import TextTransformer from '@/components/ui/TextTransformer.astro';

const FLAVORS = [
  { value: 'latte', label: 'Latte', mode: 'light' },
  { value: 'frappe', label: 'Frappé', mode: 'dark' },
  { value: 'macchiato', label: 'Macchiato', mode: 'dark' },
  { value: 'mocha', label: 'Mocha', mode: 'dark' },
] as const;

const ACCENTS = [
  'Rosewater',
  'Flamingo',
  'Pink',
  'Mauve',
  'Red',
  'Maroon',
  'Peach',
  'Yellow',
  'Green',
  'Teal',
  'Sky',
  'Sapphire',
  'Blue',
  'Lavender',
] as const;

const accentMiddleIndex = Math.floor(ACCENTS.length / 2);
---

<PopoverContent
  side='bottom'
  align='end'
  aria-label='Appearance Settings'
  class='p-4'
>
  <div data-appearance-controller>
    <div class='mb-2 flex items-center justify-between'>
      <PopoverTitle class='mb-0' data-flavor-title>
        <TextTransformer>
          <span slot='original'>Flavor</span>
          <span slot='transformed'>Dark Flavor</span>
        </TextTransformer>
      </PopoverTitle>
      <Switch id='match-system' label='System' size='sm' />
    </div>
    <div class='grid grid-cols-2 gap-2'>
      {
        FLAVORS.map(({ value, label, mode }) => (
          <Button
            variant='secondary'
            size='sm'
            class='
              justify-start px-4! text-sm font-medium text-foreground
              transition-all
            '
            data-flavor={value}
            data-flavor-mode={mode}
          >
            <span class='relative inline-flex size-4.5'>
              {mode === 'light' && (
                <SunIcon
                  class='size-full transition-opacity duration-150'
                  data-icon-outline
                />
              )}
              {mode === 'light' && (
                <SunIconFilled
                  class='
                    absolute inset-0 size-full opacity-0 transition-opacity
                    duration-150
                  '
                  data-icon-filled
                />
              )}
              {mode === 'dark' && (
                <MoonIcon
                  class='size-full transition-opacity duration-150'
                  data-icon-outline
                />
              )}
              {mode === 'dark' && (
                <MoonIconFilled
                  class='
                    absolute inset-0 size-full opacity-0 transition-opacity
                    duration-150
                  '
                  data-icon-filled
                />
              )}
            </span>
            {label}
          </Button>
        ))
      }
    </div>

    <PopoverTitle class='mt-popover-section'>Accent</PopoverTitle>
    <div class='grid grid-cols-7 place-items-center gap-3'>
      {
        ACCENTS.map((label, index) => {
          const value = label.toLowerCase();

          return (
            <Tooltip>
              <TooltipTrigger>
                <button
                  class='flex-center dot-7 bouncy-click transition-all'
                  style={`background-color: var(--ctp-${value})`}
                  data-accent={value}
                  aria-label={`Select ${label} accent`}
                >
                  <svg
                    class='hidden size-4 animate-in text-background zoom-in-50'
                    viewBox='0 0 24 24'
                    data-check
                  >
                    <use href='#icon-check' />
                  </svg>
                </button>
              </TooltipTrigger>
              <TooltipContent
                sideOffset={16}
                side={index < accentMiddleIndex ? 'top' : 'bottom'}
              >
                {label}
              </TooltipContent>
            </Tooltip>
          );
        })
      }
    </div>
  </div>
</PopoverContent>
