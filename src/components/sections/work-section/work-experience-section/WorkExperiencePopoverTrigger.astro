---
import { PopoverTrigger } from '@/components/starwind/popover';
import {
  Tooltip,
  TooltipContent,
  TooltipTrigger,
} from '@/components/starwind/tooltip';
import ItemButton from '@/components/ui/ItemButton.astro';

import WorkExperienceSectionCompanyLogo from './WorkExperienceSectionCompanyLogo.astro';

import type { WorkExperienceRecord } from './data';

interface Props {
  record: WorkExperienceRecord;
}

const { record } = Astro.props;
---

<PopoverTrigger asChild>
  <ItemButton
    name={record.company.name}
    description={record.title}
    popoverIndicator={{ orientation: 'down' }}
  >
    {
      record.endDate && (
        <WorkExperienceSectionCompanyLogo
          slot='icon'
          record={record}
          classes={{ image: 'muted-icon' }}
        />
      )
    }

    {
      !record.endDate && (
        <Tooltip slot='icon'>
          <TooltipTrigger>
            <WorkExperienceSectionCompanyLogo
              record={record}
              classes={{ image: 'muted-icon' }}
            />
          </TooltipTrigger>
          <TooltipContent>Current company</TooltipContent>
        </Tooltip>
      )
    }
  </ItemButton>
</PopoverTrigger>
