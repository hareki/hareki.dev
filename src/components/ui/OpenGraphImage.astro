---
import favicon from '@/assets/favicon.svg';

// This component is used to generate Open Graph images

const standardDimensions = {
  width: 1200,
  height: 630,
};

const twitterDimensions = {
  width: 1200,
  height: 675,
};

const useStandard = true;
---

<div
  class='
    flex-center flex-col gap-5 bg-linear-to-br from-(--ctp-base)
    to-(--ctp-crust)
  '
  style={`width: ${useStandard ? standardDimensions.width : twitterDimensions.width}px;` +
    `height: ${useStandard ? standardDimensions.height : twitterDimensions.height}px;`}
>
  <img alt='' class='size-38' src={favicon.src} />
  <h1 class='text-7xl font-bold'>Hareki</h1>
  <div class='rounded-full bg-mauve/10 px-6 py-3 text-4xl text-mauve'>
    Software Engineer
  </div>
</div>
