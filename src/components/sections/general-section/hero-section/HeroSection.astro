---
/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */
import BriefcaseIcon from '@tabler/icons/outline/briefcase.svg';
import MapPinIcon from '@tabler/icons/outline/map-pin.svg';

import {
  Tooltip,
  TooltipContent,
  TooltipTrigger,
} from '@/components/starwind/tooltip';

import LetterTransformer from './LetterTransformer.astro';
---

<section id='hero' class='revealing'>
  <div class='space-y-5'>
    <h1 class='
      text-3xl font-bold
      md:text-4xl
    '>
      Hey! I'm
      <Tooltip openDelay={0} closeDelay={0} disableHoverableContent>
        <TooltipTrigger>
          <span
            class='group cursor-help text-primary'
            tabindex='0'
            lang='vi'
            aria-label='Tu "Hareki" Nguyen'
            >T<LetterTransformer original='u' transformed='ú' /> "Hareki" <span
              class='whitespace-nowrap'
              >Nguy<LetterTransformer original='e' transformed='ễ' />n</span
            ></span
          >
        </TooltipTrigger>
        <TooltipContent side='top' animationDuration={350} sideOffset={14}>
          Pronounced "too nwin", or just Hareki
        </TooltipContent>
      </Tooltip>
    </h1>
    <div class='flex flex-wrap gap-x-6 gap-y-1.5'>
      <div
        class='
          flex items-center gap-1.5 text-lg text-subtext1-foreground
          md:text-xl
        '
      >
        <BriefcaseIcon class='size-5' />
        <span>Software Engineer</span>
      </div>

      <div
        class='
          flex items-center gap-1.5 text-lg text-subtext1-foreground
          md:text-xl
        '
      >
        <MapPinIcon class='size-5' />
        <span>HCMC, Vietnam</span>
      </div>
    </div>
    <p
      class='
        max-w-prose text-base/relaxed text-subtext0-foreground
        md:text-lg/relaxed
      '
    >
      I craft accessible, pixel-perfect interfaces and engaging user
      experiences, with a deep focus on performance and attention to detail. I'm
      also a Neovim power user with a Glove80.
    </p>
  </div>
</section>
