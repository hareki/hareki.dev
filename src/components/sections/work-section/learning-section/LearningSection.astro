---
import figma from '@/assets/technologies/figma.svg';
import nestjs from '@/assets/technologies/nestjs.svg';
// import go from '@/assets/technologies/go2.svg';
import SectionTitle from '@/components/ui/SectionTitle.astro';

import TechItem, { type TechItemProps } from '../TechItem.astro';

const techs: TechItemProps[] = [
  {
    name: 'NestJS',
    description: 'Node.js Framework',
    href: 'https://nestjs.com/',
    icon: nestjs,
    iconClass: 'size-11',
  },
  // {
  //   name: 'Go',
  //   description: 'Backend Language',
  //   href: 'https://go.dev',
  //   icon: go,
  //   iconClass: 'size-11',
  // },
  {
    name: 'Figma',
    description: 'Design Tool',
    href: 'https://figma.com',
    icon: figma,
    iconClass: 'size-8',
  },
];
---

<section
  id='learning'
  class='
    work-subgrid-span grid revealing grid-cols-subgrid grid-rows-[auto_1fr]
    revealing-2
  '
>
  <SectionTitle>Learning</SectionTitle>
  <div class='work-subgrid-span grid h-fit grid-cols-subgrid gap-x-6 gap-y-3'>
    {techs.map((tech) => <TechItem {...tech} />)}
  </div>
</section>
