---
import '@/styles/index.css';
import SvgSprite from '@/components/ui/SvgSprite.astro';

import Footer from './Footer.astro';
import Header from './header';
import BaseLayout from '../BaseLayout.astro';

interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<BaseLayout {title}>
  <SvgSprite />
  <a
    href='#main-content'
    class='
      sr-only rounded-md bg-primary px-2! py-1! font-bold
      text-primary-foreground
      focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50
    '
  >
    Skip to main content
  </a>
  <div
    class='
      mx-auto flex min-h-screen max-w-5xl flex-col px-2 pb-4 text-foreground
      xs:px-3
    '
  >
    <Header />
    <main
      id='main-content'
      class='
        grow px-2.5 py-10
        xs:px-3
        md:px-6
      '
    >
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  import { easterEggLog } from './utils';
  easterEggLog();
</script>
