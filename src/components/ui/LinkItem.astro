---
import { cn } from 'tailwind-variants';

import ItemButton from './ItemButton.astro';
import NewTabIndicator from './NewTabIndicator.astro';

interface Props {
  name: string;
  description?: string;
  href: string;
  class?: string;
  size?: 'sm' | 'md';
}

const { name, description, href, class: className, size = 'md' } = Astro.props;
---

<ItemButton
  name={name}
  description={description}
  href={href}
  target='_blank'
  size={size}
  class={cn('group relative', className)}
>
  <slot name='icon' slot='icon' />
  <NewTabIndicator />
</ItemButton>
