---
import DotsIcon from '@tabler/icons/outline/dots.svg';

interface Props {
  original: string;
  transformed: string;
}

const { original, transformed } = Astro.props;
---

<span class='relative inline-flex opacity-75'>
  <span class='
    inline-grid overflow-hidden py-0.5
    *:[grid-area:1/1]
  '>
    <span
      class='
        group-hocus:opacity-0
        motion-safe:transition-[opacity,translate]
        motion-safe:group-hocus:-translate-y-full
        motion-reduce:transition-opacity
      '
      >{original}</span
    >
    <span
      class='
        opacity-0
        group-hocus:opacity-100
        motion-safe:translate-y-full motion-safe:transition-[opacity,translate]
        motion-safe:group-hocus:translate-y-0
        motion-reduce:transition-opacity
      '
      aria-hidden='true'
    >
      {transformed}
    </span>
  </span>
  <DotsIcon class='absolute -bottom-3 -left-px' aria-hidden='true' />
</span>
