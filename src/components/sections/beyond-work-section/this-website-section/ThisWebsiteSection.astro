---
import BrowserIcon from '@tabler/icons/outline/browser.svg';

import Badge from '@/components/ui/Badge.astro';
import InlineLink from '@/components/ui/InlineLink.astro';
import SubSection from '@/components/ui/sub-section';
import SubSectionDescription from '@/components/ui/sub-section/SubSectionDescription.astro';
import SubSectionTitle from '@/components/ui/sub-section/SubSectionTitle.astro';
import SubsectionTitle from '@/components/ui/SubsectionTitle.astro';
import { PROJECT_REPO_FULL_NAME } from '@/data/git';

import { ThisWebSiteData } from './data';
---

<SubSection id='beyond-work-this-website' class='revealing revealing-5'>
  <SubSectionTitle icon={BrowserIcon}>This Website</SubSectionTitle>
  <SubSectionDescription>
    My first project with <InlineLink href='https://astro.build/'
      >Astro</InlineLink
    >, also my first website outside of work. Built from scratch with clear
    goals in mind. <InlineLink
      href={`https://github.com/${PROJECT_REPO_FULL_NAME}`}>Source</InlineLink
    > on GitHub.
  </SubSectionDescription>

  <div class='rounded-md bg-sub-section px-2.5 py-4 text-sm'>
    <SubsectionTitle class='px-1.5'>Core Principles</SubsectionTitle>
    <div class='mb-4 flex flex-col'>
      {
        ThisWebSiteData.CORE_PRINCIPLES.map(({ name, description }) => {
          return (
            <span
              class='
                group inline-flex max-w-full rounded-xs p-1.5
                text-subtext0-foreground
              '
            >
              <div>
                <span class='whitespace-nowrap text-foreground'>{name}</span>
                <span>{description}</span>
              </div>
            </span>
          );
        })
      }
    </div>

    <div class='px-1.5'>
      <SubsectionTitle>Technologies</SubsectionTitle>
      <div class='flex flex-wrap gap-2'>
        {
          ThisWebSiteData.TECHNOLOGIES.map(({ name, color }) => (
            <Badge color={color}>{name}</Badge>
          ))
        }
      </div>
    </div>
  </div>
</SubSection>
