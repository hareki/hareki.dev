---
import { cn } from 'tailwind-variants';

const { class: className } = Astro.props;
---

<svg
  class={cn(
    `
      pointer-events-none absolute -top-1.25 -right-1.25 size-4 opacity-0
      transition-all duration-500 ease-overshoot
      group-hocus:-top-1.25 group-hocus:-right-1.25 group-hocus:opacity-100
      group-hocus:not-disabled:scale-100
      motion-safe:top-2.5 motion-safe:right-2.5 motion-safe:scale-0
    `,
    className,
  )}
  viewBox='0 0 24 24'
>
  <use href='#icon-external-link'></use>
</svg>
